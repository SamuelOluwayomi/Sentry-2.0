{
  "name": "sentry-protocol",
  "bin": {
    "sentry": "./cli.js"
  },
  "scripts": {
    "build": "NODE_OPTIONS='--dns-result-order=ipv4first' next build",
    "ci": "npm run build && npm run lint && npm run format:check",
    "dev": "NODE_OPTIONS='--dns-result-order=ipv4first' next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "start": "NODE_OPTIONS='--dns-result-order=ipv4first' next start",
    "cli": "node cli.js",
    "server": "npx tsx server.ts",
    "harness:faults": "npx tsx scripts/harnesses/harness_faults.ts",
    "harness:trader": "npx tsx scripts/harnesses/harness_trader.ts",
    "harness:requote": "npx tsx scripts/harnesses/harness_requote.ts",
    "harness:sniper": "npx tsx scripts/harnesses/harness_sniper.ts",
    "harness:budget": "npx tsx scripts/harnesses/harness_budget.ts",
    "harness:mev": "npx tsx scripts/harnesses/harness_mev.ts"
  },
  "description": "Next.js, Tailwind, @solana/react-hooks",
  "keywords": [
    "kit",
    "smart-tx-observatory",
    "react",
    "solana-kit",
    "tailwind",
    "typescript"
  ],
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "@solana/client": "^1.2.0",
    "@solana/react-hooks": "^1.1.5",
    "@solana/web3.js": "^1.98.4",
    "next": "16.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@next/swc-linux-x64-gnu": "^16.2.9",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
