{
  "name": "sentry-protocol",
  "bin": {
    "sentry": "./cli.js"
  },
  "scripts": {
    "build": "NODE_OPTIONS='--dns-result-order=ipv4first' next build",
    "ci": "npm run build && npm run lint && npm run format:check",
    "dev": "NODE_OPTIONS='--dns-result-order=ipv4first' next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "start": "NODE_OPTIONS='--dns-result-order=ipv4first' next start",
    "cli": "node cli.js",
    "server": "npx tsx server.ts",
    "benchmark:devnet": "jiti scripts/benchmark_1000_devnet.ts",
    "replay": "jiti scripts/replay_scenario.ts",
    "benchmark:mainnet": "jiti scripts/benchmark_100_mainnet.ts",
    "check:live": "jiti scripts/check_live.ts",
    "monitor": "jiti scripts/monitor_live.ts",
    "tape": "jiti scripts/monitor_live.ts",
    "docs": "npm --prefix docs run dev",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build"
  },
  "description": "Next.js, Tailwind, @solana/react-hooks",
  "keywords": [
    "kit",
    "smart-tx-observatory",
    "react",
    "solana-kit",
    "tailwind",
    "typescript"
  ],
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@orca-so/whirlpools-sdk": "^0.22.0",
    "@solana/client": "^1.2.0",
    "@solana/react-hooks": "^1.1.5",
    "@solana/web3.js": "^1.98.4",
    "@triton-one/yellowstone-grpc": "^9.0.0",
    "decimal.js": "^10.6.0",
    "next": "16.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "tweetnacl": "^1.0.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@next/swc-linux-x64-gnu": "^16.2.9",
    "@tailwindcss/postcss": "^4",
    "@types/bn.js": "^5.2.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
