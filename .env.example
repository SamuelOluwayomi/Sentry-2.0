# Sentry 2.0 environment configuration.
# Copy this file to .env and fill in your values.

# Solami API key (sign up: https://solami.dev/signup?ref=st-earn-sep-26)
SOLAMI_API_KEY=your_solami_api_key_here

# Solana RPC via Solami
SOLANA_RPC_URL=https://rpc.solami.dev/sol?api_key=your_solami_api_key_here
NEXT_PUBLIC_RPC_URL=https://rpc.solami.dev/sol?api_key=your_solami_api_key_here

# Yellowstone gRPC via Solami (Pro plan: 2 concurrent streams)
# Solami Blur WebSocket (decoded market data: swaps, liquidity, launches)
# Uses SOLAMI_API_KEY above automatically

GRPC_ENDPOINT=https://grpc.solami.dev
GRPC_TOKEN=your_solami_api_key_here

# Transaction provider: beam (primary) or jito (fallback)
TX_PROVIDER=beam

# Solami Beam endpoint
BEAM_ENDPOINT=https://beam.solami.dev

# Jito block engine, used only when TX_PROVIDER=jito
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf

# Wallet keypair as a JSON byte array. Minimum balance: 50,000 lamports.
WALLET_PRIVATE_KEY=[122,94,84,33,...]

# Groq API key for the AI agent and dashboard chat
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional log path overrides
# LIFECYCLE_LOG_PATH=lifecycle_log.jsonl
# AGENT_DECISIONS_PATH=agent_decisions.jsonl
# EVENT_LOG_PATH=logs/event_log.jsonl
# LOGS_DIR=../logs

# Engine run count (default 12; last 2 runs are intentional fault injections)
# RUN_COUNT=12

# Manual fault injection: zero-tip | expired-hash
# FAIL_TEST=

# AI agent daemon mode
# DAEMON=true
# DAEMON_INTERVAL=10000

# Optional: additional AI providers for tip decision cascade (Groq is primary)
ANTHROPIC_API_KEY=sk-ant-your_key_here
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=sk-your_openai_key_here
